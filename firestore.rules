rules_version = '2';

// Правила Firestore для SecretMessanger.
//
// До 2026-08-04 здесь стоял дефолт `allow read, write: if request.auth != null`
// на `/{document=**}` — то есть любой вошедший аккаунт мог прочитать переписку всех
// остальных, переписать её или удалить. Ниже — правила по фактической схеме данных.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Реестр логинов: один документ на каждый занятый логин, id документа — логин
    // в нижнем регистре. Регистр в ключ не попадает намеренно: иначе `red` и `Red`
    // считались бы разными именами, и уникальность распадалась бы ровно там, где
    // она нужнее всего — на похожих написаниях.
    //
    // Уникальность держится на том, что `create` по уже существующему документу
    // Firestore запрещает сам. Клиентская проверка «занят ли логин» гонку двух
    // одновременных регистраций не закрывает никогда — а это правило закрывает.
    match /logins/{login} {

      // `get` открыт всем, включая невошедших: экран регистрации проверяет логин
      // до создания аккаунта, когда сессии ещё нет. `list` при этом закрыт —
      // спросить про одно конкретное имя можно, выгрузить весь список разом нельзя.
      allow get: if true;
      allow list: if false;

      // Занять логин может только тот, кто в нём записан, и только под ключом,
      // который этому логину соответствует: без последней проверки можно было бы
      // занять документ `red`, положив внутрь `login: "blue"`.
      allow create: if signedIn()
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.login is string
                    && request.resource.data.login.lower() == login;

      // Перезаписать чужую (да и свою) запись нельзя: смена логина — это освободить
      // старый документ и занять новый, а не подменить содержимое существующего.
      allow update: if false;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // Профиль пользователя.
    //
    // Читать может любой вошедший: на этом держится экран «Контакты», который
    // перечисляет всех пользователей. Писать — только владелец: id документа равен
    // uid из Auth, а uid проверен сервером и подделать его нельзя.
    match /users/{userId} {

      // Логин в профиле обязан быть занят этим же пользователем в реестре. Без
      // этой проверки реестр остался бы договорённостью клиента: занимать логины
      // никто не мешает, но вписать себе в профиль чужой можно было бы напрямую —
      // а контакты и заголовок диалога показывают именно поле профиля.
      //
      // `get()` по несуществующему документу роняет проверку целиком, и это здесь
      // ровно то, что нужно: профиль с незанятым логином записывать нельзя.
      function ownsLogin() {
        return request.resource.data.login is string
               && get(/databases/$(database)/documents/logins/$(request.resource.data.login.lower())).data.uid == userId;
      }

      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == userId && ownsLogin();
      allow delete: if false;
    }

    // Диалог — на двоих или групповой, правила одни и те же.
    match /conversation/{convoId} {

      function isMember() {
        return signedIn() && request.auth.uid in resource.data.users;
      }

      function joiningAsMember() {
        return signedIn() && request.auth.uid in request.resource.data.users;
      }

      // `owner` — создатель диалога, единственный, кто меняет состав участников.
      // У диалогов, созданных до появления поля, его нет: `get('owner', '')` даёт
      // пустую строку, которая не равна ничьему uid, поэтому состав такого диалога
      // не изменит никто. Это осознанно — задним числом назначать себя создателем
      // чужого чата не должен никто.
      function isOwner() {
        return signedIn() && request.auth.uid == resource.data.get('owner', '');
      }

      function ownerUnchanged() {
        return request.resource.data.get('owner', '') == resource.data.get('owner', '');
      }

      function membersUnchanged() {
        return request.resource.data.users == resource.data.users;
      }

      // Ключи диалога раздаёт тот же, кто правит состав, — иначе участник мог бы
      // подменить чужую запись и оставить человека с нечитаемой перепиской. Поле
      // называется `convoKeys`, а не `keys`, намеренно: `keys()` — метод карты в
      // самих правилах, и поле с этим именем читалось бы неоднозначно.
      function keysUnchanged() {
        return request.resource.data.get('convoKeys', {}) == resource.data.get('convoKeys', {})
               && request.resource.data.get('keyVersion', 0) == resource.data.get('keyVersion', 0);
      }

      // Выход по своей воле — единственный случай, когда участник пишет состав, из
      // которого себя вычёркивает. Поэтому условие отдельное: `joiningAsMember()`
      // требует остаться в диалоге, и под общую ветку это не подводится.
      //
      // Вычеркнуть разрешено ровно себя и никого больше — состав после записи обязан
      // совпасть со старым минус свой uid. Создателю выход закрыт: группа осталась бы
      // без того, кто может править состав, а передачи прав пока нет.
      function leaving() {
        return isMember()
               && request.auth.uid != resource.data.get('owner', '')
               && request.resource.data.users == resource.data.users.removeAll([request.auth.uid])
               && ownerUnchanged()
               && keysUnchanged();
      }

      // Читаем по массиву `users`: запрос экрана «Чаты»
      // (`whereField("users", arrayContains: uid)`) ровно этому условию и
      // соответствует, поэтому список собирается, а чужие диалоги не отдаются.
      allow read: if isMember();

      allow create: if joiningAsMember()
                    && request.resource.data.get('owner', '') == request.auth.uid;

      // Обычная запись — это `lastMessage`, `date` и карта `logins`: её делает
      // любой участник при каждой отправке, и состав она не трогает. Менять состав
      // разрешено только создателю, и по-прежнему проверяются оба состояния: он
      // обязан остаться в диалоге, иначе группу можно было бы бросить без хозяина.
      allow update: if (isMember()
                       && joiningAsMember()
                       && ownerUnchanged()
                       && (membersUnchanged() || isOwner())
                       && (keysUnchanged() || isOwner()))
                    || leaving();
      allow delete: if false;

      // Сообщения.
      //
      // Состав берётся из документа-шапки, а не из id диалога. Для переписки на
      // двоих участие можно было прочитать прямо из пути (id — пара uid по
      // алфавиту), но в группе состав в id не закодируешь, тем более что теперь он
      // ещё и меняется. Плата за это — лишнее чтение документа на каждую операцию
      // с сообщением, и требование, чтобы шапка существовала до первого сообщения:
      // клиент пишет её первой.
      match /messages/{messageId} {

        function members() {
          return get(/databases/$(database)/documents/conversation/$(convoId)).data.users;
        }

        allow read: if signedIn() && request.auth.uid in members();
        allow create: if signedIn()
                      && request.auth.uid in members()
                      && request.resource.data.senderId == request.auth.uid;
        allow update, delete: if false;
      }
    }
  }
}
