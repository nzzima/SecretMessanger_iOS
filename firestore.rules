rules_version = '2';

// Правила Firestore для SecretMessanger.
//
// До 2026-08-04 здесь стоял дефолт `allow read, write: if request.auth != null`
// на `/{document=**}` — то есть любой вошедший аккаунт мог прочитать переписку всех
// остальных, переписать её или удалить. Ниже — правила по фактической схеме данных.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Профиль пользователя.
    //
    // Читать может любой вошедший: на этом держится экран «Контакты», который
    // перечисляет всех пользователей. Писать — только владелец: id документа равен
    // uid из Auth, а uid проверен сервером и подделать его нельзя.
    match /users/{userId} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == userId;
      allow delete: if false;
    }

    // Диалог.
    match /conversation/{convoId} {

      // Участие в самих сообщениях проверяется по id диалога, а не по документу-шапке.
      // Id собран из пары uid, отсортированных по алфавиту, поэтому чужой диалог
      // просто не содержит твоего uid. Так дешевле (не нужно читать родительский
      // документ) и, главное, работает для первого сообщения: клиент пишет сообщение
      // раньше, чем шапку диалога, и на этот момент шапки ещё не существует.
      function isParticipant() {
        return signedIn() && convoId.split('_').hasAny([request.auth.uid]);
      }

      // Шапку читаем по массиву `users`: запрос экрана «Чаты»
      // (`whereField("users", arrayContains: uid)`) ровно этому условию и
      // соответствует, поэтому список собирается, а чужие диалоги не отдаются.
      allow read: if signedIn() && request.auth.uid in resource.data.users;
      allow create, update: if signedIn() && request.auth.uid in request.resource.data.users;
      allow delete: if false;

      // Сообщения неизменяемы: отправитель обязан совпадать с вошедшим аккаунтом,
      // править и удалять чужое (и своё) нельзя.
      match /messages/{messageId} {
        allow read: if isParticipant();
        allow create: if isParticipant() && request.resource.data.senderId == request.auth.uid;
        allow update, delete: if false;
      }
    }
  }
}
